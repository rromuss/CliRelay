# Add this site block to the existing Caddyfile; never replace existing sites.
# Connect only Caddy and CliRelay to the dedicated clirelay-public-ingress network.
https://cliprelay.romus.pro:8443 {
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}
	@models {
		method GET
		path /v1/models
		expression `{http.request.orig_uri}.matches('^/v1/models([?]client_version=[0-9.]+)?$')`
	}
	handle @models {
		rewrite * /external/v1/models
		reverse_proxy clirelay-public-backend:8317
	}
	@responses {
		method POST
		path /v1/responses
		expression `{http.request.orig_uri}.matches('^/v1/responses([?]client_version=[0-9.]+)?$')`
	}
	handle @responses {
		rewrite * /external/v1/responses
		reverse_proxy clirelay-public-backend:8317 {
			stream_timeout 120s
			header_up -Cookie
			header_up -X-Management-Key
		}
	}
	@catalog {
		method GET
		path /codex/models
		expression `{http.request.orig_uri}.matches('^/codex/models([?]client_version=[0-9.]+)?$')`
	}
	handle @catalog {
		rewrite * /external/codex/models
		reverse_proxy clirelay-public-backend:8317
	}
	handle {
		respond 404
	}
}
